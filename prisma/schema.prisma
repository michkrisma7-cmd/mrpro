generator client {
  provider = "prisma-client-js"
  engineType = "client"
  output = "../node_modules/.prisma/client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  USER
  ADMIN
}
enum ListingStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}
enum FieldType {
  TEXT
  NUMBER
  PRICE
  SELECT
  MULTISELECT
}
model AppUser {
  id String @id @default(cuid())
  authId String @unique
  name String
  email String
  role Role @default(USER)
  properties Property[]
  uploads Media[]
  createdAt DateTime @default(now())
}
model Property {
  id String @id @default(cuid())
  slug String @unique
  title String
  description String
  gallery String[]
  values Json @default("{}")
  whatsapp String
  status ListingStatus @default(PENDING)
  featured Boolean @default(false)
  ownerId String
  owner AppUser @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([ownerId])
}
model PropertyField {
  id String @id @default(cuid())
  key String @unique
  name String
  type FieldType
  options String[]
  required Boolean @default(false)
  showInForm Boolean @default(true)
  showOnCard Boolean @default(false)
  showOnDetail Boolean @default(true)
  cardLabel String @default("")
  position Int @default(0)
  createdAt DateTime @default(now())
}
model Service {
  id String @id @default(cuid())
  slug String @unique
  type String
  workerName String
  skills String[]
  description String
  minPrice Int
  unit String @default("hari")
  image String @default("")
  whatsapp String
  active Boolean @default(true)
  createdAt DateTime @default(now())
}
model Media {
  id String @id @default(cuid())
  key String @unique
  ownerId String
  owner AppUser @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
}
model SiteSettings {
  id String @id @default("main")
  heroTitle String @default("Ruang baru, cerita baru.")
  heroDescription String @default("Temukan tempat untuk pulang, ruang untuk bertumbuh, dan partner untuk mewujudkannya.")
  whatsapp String @default("")
  email String @default("")
  area String @default("Indonesia")
}
