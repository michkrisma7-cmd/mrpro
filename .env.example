# Isi nilai sebenarnya melalui secrets/runtime environment. Jangan commit kredensial.
DATABASE_URL=
NEON_AUTH_URL=
# Secret aplikasi acak minimal 32 karakter; buat sekali dengan openssl rand -base64 32.
NEON_AUTH_COOKIE_SECRET=
# Origin HTTPS kanonis untuk metadata, sitemap, serta konfigurasi trusted origins Neon.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Bucket publik yang sudah dibuat oleh pemilik proyek.
AWS_S3_BUCKET=bucket
