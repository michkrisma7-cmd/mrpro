# Isi nilai sebenarnya melalui secrets/runtime environment. Jangan commit kredensial.
DATABASE_URL=
# Secret acak untuk GET/POST /api/blog melalui header x-api-key (server-only).
BLOG_API_KEY=
# Secret acak minimal 32 karakter; bun auth:setup membuatnya jika belum ada.
AUTH_SECRET=
# Origin kanonis untuk metadata dan sitemap (HTTP localhost didukung).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# false pada beta/staging; production HTTPS + database diindeks secara default.
SEO_INDEXING=false
# Token verifikasi HTML Google Search Console (opsional).
GOOGLE_SITE_VERIFICATION=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Bucket publik yang sudah dibuat oleh pemilik proyek.
AWS_S3_BUCKET=bucket

# Chat: webhook n8n production, server-only; Header Auth n8n memakai x-mr-token.
N8N_CHAT_WEBHOOK_URL=https://n8n.mrproperti.com/webhook/mr-konsultasi
N8N_CHAT_WEBHOOK_SECRET=

# Origin ngrok yang diizinkan untuk Chat saat next dev (opsional).
CHAT_DEV_SITE_URL=https://6084-114-79-5-7.ngrok-free.app
