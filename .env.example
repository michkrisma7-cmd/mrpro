# Isi nilai sebenarnya melalui secrets/runtime environment. Jangan commit kredensial.
DATABASE_URL=
# Secret acak untuk POST /api/blog melalui header x-api-key (server-only).
BLOG_API_KEY=
NEON_AUTH_URL=
# Opsional: URL JWKS publik atau JSON JWKS, untuk pemeriksaan/verifikasi JWT.
# SDK Neon Auth mengelola sesi cookie tanpa variabel ini.
JWKS_NEON=
# Secret aplikasi acak minimal 32 karakter; bun auth:setup membuatnya jika belum ada.
NEON_AUTH_COOKIE_SECRET=
# Origin HTTPS kanonis untuk metadata, sitemap, serta konfigurasi trusted origins Neon.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Bucket publik yang sudah dibuat oleh pemilik proyek.
AWS_S3_BUCKET=bucket
