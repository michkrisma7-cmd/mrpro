    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $('Properti Diterbitkan').first().json.body;\nconst urls = body.image_urls;\nif (!Array.isArray(urls) || urls.length === 0) throw new Error('Payload image_urls wajib berisi foto properti.');\nconst pageId = $input.first().json.id;\nif (!pageId) throw new Error('Page ID tidak ditemukan.');\nreturn urls.map((url) => {\n  if (typeof url !== 'string' || !url.startsWith('https://')) throw new Error('URL foto harus HTTPS publik.');\n  return { json: { pageId, url } };\n});"
      },
      "id": "prepare-property-photos",
      "name": "Siapkan Semua Foto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-160, 272]
    },
    {
      "parameters": {
        "httpRequestMethod": "POST",
        "graphApiVersion": "v25.0",
        "node": "={{ $json.pageId }}",
        "edge": "photos",
        "options": {
          "queryParametersJson": "={{ JSON.stringify({ published: false, url: $json.url }) }}"
        }
      },
      "type": "n8n-nodes-base.facebookGraphApi",
      "typeVersion": 1,
      "position": [64, 272],
      "id": "4c6e7d31-4820-4508-9e4c-c664c4acb815",
      "name": "Upload Photos",
      "credentials": {
        "facebookGraphApi": {
          "id": "NopZUWzDie9h7H2x",
          "name": "Facebook Graph account"
        }
      },
      "retryOnFail": false
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const uploaded = $input.all();\nconst expected = $('Siapkan Semua Foto').all();\nif (uploaded.length !== expected.length || uploaded.some(item => !item.json.id || item.json.error)) throw new Error('Upload foto belum lengkap; feed tidak diterbitkan.');\nconst body = $('Properti Diterbitkan').first().json.body;\nreturn [{ json: { pageId: expected[0].json.pageId, message: [body.message, body.link].filter(Boolean).join('\\n\\n'), attached_media: uploaded.map(item => ({ media_fbid: String(item.json.id) })) } }];"
      },
      "id": "aggregate-property-photos",
      "name": "Gabungkan ID Foto",
